# Salin ke .env.local lalu isi. Berkas .env.local sudah masuk .gitignore.

# --- Aplikasi ---------------------------------------------------------------
# Dasbor Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Perintah basis data (pnpm db:push / db:status / db:types) ---------------
# Dasbor Supabase -> Project Settings -> Database -> Connection string -> URI
#
# Dipakai lewat --db-url, jadi akun mana yang sedang login di Supabase CLI tidak
# berpengaruh. Berguna kalau proyek ini berada di akun yang berbeda dari akun
# yang biasa dipakai di mesin ini.
#
# Pakai koneksi langsung atau session pooler (port 5432); transaction pooler
# (6543) tidak cocok untuk migrasi. Percent-encode sandi bila mengandung
# @ : / ? # atau spasi.
SUPABASE_DB_URL=postgresql://postgres:SANDI@db.REF.supabase.co:5432/postgres
